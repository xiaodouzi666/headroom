+def test_missing_source_file_leaves_only_that_role_unbound(tmp_path):
+    left, right = captured("baseline"), captured("candidate")
+    original = tmp_path / "original.py"
+    original.write_text("pass\n")
+    result = coverage.bind_training_coverage_sources(
+        left, original, right, tmp_path / "missing-candidate.py"
