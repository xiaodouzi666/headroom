+
+def test_actual_unreadable_source_remains_unbound_without_raising(tmp_path):
+    left, right = captured("baseline"), captured("candidate")
+    original, candidate = tmp_path / "original.py", tmp_path / "candidate.py"
+    original.write_text("pass\n")
+    candidate.write_text("pass\n")
+    original.chmod(0)
+    try:
+        result = coverage.bind_training_coverage_sources(left, original, right, candidate)
+    finally:
+        original.chmod(0o600)
+    assert set(result) == {"candidate"}
+    assert coverage.training_coverage_evidence(left, right, result)["not_reduced"] is None
+
+
+@pytest.mark.parametrize(
+    "error",
+    [
+        OSError("missing source"),
+        PermissionError("unreadable source"),
+        ValueError("bad source contract"),
+        TypeError("bad source path"),
+    ],
+)
+def test_source_contract_failure_cannot_abort_verification_evidence(tmp_path, monkeypatch, error):
+    def unavailable(_script):
+        raise error
+
+    monkeypatch.setattr(coverage, "source_contract", unavailable)
+    left, right = captured("baseline"), captured("candidate")
