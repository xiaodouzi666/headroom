        monkeypatch.setattr("headroom.orchestrator.annotate_evidence_bundle", recover)
        pipeline = tmp_path / "pipeline"
        pipeline.mkdir()
        result, source_store, calls, _, _ = search_run(
            pipeline,
            [{"before": "VALUE = 1\n", "after": "VALUE = 2\n", "peak": 20, "target": True}],
            max_rounds=1,
