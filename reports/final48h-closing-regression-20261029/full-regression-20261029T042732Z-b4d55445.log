                    except EOFError:
                        break
                    if kind == "ready":
                        ready = True
                        receiver.send("proceed")
                    else:
                        outcome = kind
                        result = payload
                        break
    
        except (OSError, EOFError):
            outcome = "error"
        finally:
            cleaned = (
