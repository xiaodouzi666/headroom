+        raise ValueError("Unknown or unclosed historical run")
+    if any(
+        not UUID.fullmatch(row["id"]) or row["run_id"] not in ids
+        or type(row["settled"]) is not int or row["settled"] != 1
+        or type(row["dispatched"]) is not int or row["dispatched"] not in {0, 1}
