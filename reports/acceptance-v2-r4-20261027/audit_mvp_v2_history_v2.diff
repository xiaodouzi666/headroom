+def exact_rows(rows, fields, key="id"):
+    """Reject duplicate identities, schema drift, and noncanonical row types."""
+    if not isinstance(rows, list) or not all(
+        isinstance(row, dict) and set(row) == fields and type(row[key]) is str
+        for row in rows
+    ):
+        raise ValueError("Incomplete historical row schema")
+    if len({row[key] for row in rows}) != len(rows):
+        raise ValueError("Duplicate historical row identity")
+    return sorted(rows, key=lambda row: row[key])
+
