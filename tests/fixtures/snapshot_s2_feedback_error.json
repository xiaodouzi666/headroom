      {
        "fix_id": "opt_foreach_to_loop",
        "type": "code",
        "title": "Replace AdamW foreach kernels with per-parameter update loop",
        "description": "Refactor the optimizer step to iterate over parameters and apply AdamW updates sequentially, avoiding the large temporary workspace allocated by torch._foreach_sqrt and related foreach ops. This targets the stk_b15b5a2937d60e6e temporaries and the optimizer_state buffers created via zeros_like.",
        "expected_saving_gb": 6.0,
        "numerics_impact": "none",
        "throughput_impact": "minor",
        "risk": "Requires custom optimizer implementation; must match AdamW numerics exactly. Test against reference implementation.",
        "requires_policy": []
      },
      {
        "fix_id": "grad_accum_avoid_zeros_like",
        "type": "code",
        "title": "Avoid zeros_like for gradient initialization",
        "description": "Where gradients are missing, allocate gradient buffers matching parameter size and dtype directly instead of using zeros_like (stk_8cd9860b135702e0), which creates optimizer_state allocations. Initialize grads in-place during backward or pre-allocate once.",
        "expected_saving_gb": 3.0,
        "numerics_impact": "none",
        "throughput_impact": "none",
        "risk": "Must ensure gradient semantics unchanged; only affects allocation pattern, not computed values.",
        "requires_policy": []
      }
    ],
