[Unit]
Description=Headroom dedicated rootless Tailscale transport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/xiaodouzi/workspace/headroom
ExecStart=/home/xiaodouzi/workspace/headroom/.tools/tailscale_1.104.4_amd64/tailscaled --tun=userspace-networking --statedir=/home/xiaodouzi/workspace/headroom/.cache/tailscale/state --socket=%t/headroom-tailscale/tailscaled.sock --port=0 --no-logs-no-support
RuntimeDirectory=headroom-tailscale
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
