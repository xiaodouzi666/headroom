NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
TAVILY_API_KEY=
HF_TOKEN=

# Health notifications remain disabled unless check_health.py is run with --notify.
# Set only in the server-private, gitignored .env (mode 0600); never commit a destination.
HEADROOM_HEALTH_WEBHOOK_URL=
HEADROOM_HEALTH_WEBHOOK_TOKEN=
# true only if your receiver guarantees deduplication by Idempotency-Key.
HEADROOM_HEALTH_WEBHOOK_IDEMPOTENT=false

# Optional judge-only custom scripts on a public demo. Keep the value private.
# Use a random 32+ character URL-safe value; examples do not require it.
HEADROOM_JUDGE_TOKEN=

# Saved-snapshot uploads are off by default; both submission flags must allow them.
# Enabling the interface does not create model credits or spending authorization.
HEADROOM_SNAPSHOT_SUBMISSIONS_ENABLED=false

# Optional API runtime profile; CLI commands also accept --runtime-profile.
# The private profile needs independently reviewed model capabilities/prices,
# available credit and an authorized total. A file path alone enables nothing.
# HEADROOM_RUNTIME_PROFILE=.cache/tokenfactory-runtime.json
# Optional shared budget database, selected only after reviewing its allocation.
# HEADROOM_BUDGET_DB_PATH=.cache/budget.db
# Optional caps only lower request limits; they never create additional credit.
# HEADROOM_RUN_BUDGET_USD=0.30
# HEADROOM_DAILY_BUDGET_USD=<your_authorized_daily_cap>

# Start a copied example configuration with public interaction disabled.
HEADROOM_RUN_SUBMISSIONS_ENABLED=false
HEADROOM_RUN_SUBMISSION_DISABLED_REASON="New runs are temporarily paused."
HEADROOM_VERIFIED_RUNS_ENABLED=false

# Public deployment only: the bare HTTPS hostname, without scheme or port.
# HEADROOM_PUBLIC_HOST=your-service.your-tailnet.ts.net
# Set forwarding trust only for the matching reviewed, loopback-only deployment.
HEADROOM_TRUST_CLOUDFLARED=false
HEADROOM_TRUST_TAILSCALE_FUNNEL=false
