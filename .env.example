NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
TAVILY_API_KEY=
HF_TOKEN=

# Health notifications remain disabled unless check_health.py is run with --notify.
# Set only in the server-private, gitignored .env (mode 0600); never commit a destination.
HEADROOM_HEALTH_WEBHOOK_URL=
HEADROOM_HEALTH_WEBHOOK_TOKEN=
# true only if your receiver guarantees deduplication by Idempotency-Key.
HEADROOM_HEALTH_WEBHOOK_IDEMPOTENT=false
